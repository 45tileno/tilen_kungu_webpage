# PostgreSQL connection values. DATABASE_URL is preferred in hosted environments.
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=contacts_db
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=5000
# Set true only when a local PostgreSQL server does not use TLS.
PGSSL_DISABLE=false

# Database-backed session lifetime
SESSION_TTL_SECONDS=604800

# SMTP email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Your Name <your-smtp-username@example.com>"
EMAIL_TO=tilenvennykungu@gmail.com

# HTTP server port
PORT=3000
